# Database
DATABASE_URL=postgresql+asyncpg://bloomberg:bloomberg_dev@localhost:5432/bloomberg
DB_POOL_MIN=10
DB_POOL_MAX=50

# Redis
REDIS_URL=redis://localhost:6379/0

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# SEC EDGAR (required - use your real company name and email)
SEC_USER_AGENT=BloombergDataFabric admin@example.com
SEC_RATE_LIMIT=10

# OpenFIGI (optional - increases rate limit from 25 to 250 req/min)
OPENFIGI_API_KEY=

# Cache TTLs (seconds)
CACHE_TTL_REFERENCE=3600
CACHE_TTL_ENTITY=900
CACHE_TTL_SECURITY=900
