# =============================================================================
# Bloomberg Terminal Clone — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables have sensible defaults for local development.
# Only SEC_USER_AGENT is strictly required for data ingestion.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://bloomberg:bloomberg_dev@localhost:5432/bloomberg
DB_POOL_MIN=10
DB_POOL_MAX=50

# -----------------------------------------------------------------------------
# Redis (caching & pub/sub)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Elasticsearch (full-text search)
# -----------------------------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200

# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
# IMPORTANT: Change JWT_SECRET_KEY in production — use a random 32+ byte string
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-32B+
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Set to "true" to require authentication on all API endpoints
REQUIRE_AUTH=false

# -----------------------------------------------------------------------------
# SEC EDGAR (Free — required for entity & filing ingestion)
# -----------------------------------------------------------------------------
# SEC requires a valid User-Agent with your company name and contact email.
# See: https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=YourCompanyName admin@yourdomain.com
SEC_RATE_LIMIT=10

# -----------------------------------------------------------------------------
# FRED API (Free — macroeconomic data)
# -----------------------------------------------------------------------------
# Get a free API key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
FRED_RATE_LIMIT=120

# -----------------------------------------------------------------------------
# EIA API (Free — US Energy Information Administration commodity stocks)
# -----------------------------------------------------------------------------
# Get a free API key at: https://www.eia.gov/opendata/register.php
# Powers real supply/demand stock-level data (weekly petroleum/natural-gas/
# gasoline stocks) for GET /global/commodities/{code}/supply-demand.
EIA_API_KEY=
EIA_RATE_LIMIT=30

# -----------------------------------------------------------------------------
# Congressional trading (Free — US STOCK Act periodic transaction reports)
# -----------------------------------------------------------------------------
# Free, public, machine-readable aggregations of House & Senate disclosures.
# Defaults point at the community house/senate-stock-watcher JSON feeds; you
# can override to any compatible feed. Used by the Smart-Money tracker to
# follow politicians such as Nancy Pelosi.
CONGRESS_HOUSE_FEED_URL=https://house-stock-watcher-data.s3-us-west-2.amazonaws.com/data/all_transactions.json
CONGRESS_SENATE_FEED_URL=https://senate-stock-watcher-data.s3-us-west-2.amazonaws.com/aggregate/all_transactions.json

# -----------------------------------------------------------------------------
# Polygon.io (Free tier — EOD stock prices)
# -----------------------------------------------------------------------------
# Get a free API key at: https://polygon.io/dashboard/signup
# Free tier: 5 API calls/min, EOD data with 15-min delay
POLYGON_API_KEY=
POLYGON_RATE_LIMIT=5

# -----------------------------------------------------------------------------
# Finnhub (Free — index constituents, e.g. S&P 500)
# -----------------------------------------------------------------------------
# Get a free API key at: https://finnhub.io/register
FINNHUB_API_KEY=

# -----------------------------------------------------------------------------
# OpenFIGI (Free — security identifier mapping)
# -----------------------------------------------------------------------------
# Optional: without a key you get 25 req/min; with a key you get 250 req/min
# Get a free key at: https://www.openfigi.com/api
OPENFIGI_API_KEY=

# -----------------------------------------------------------------------------
# Alpha Vantage (Free — forward consensus EPS/revenue estimates & guidance)
# -----------------------------------------------------------------------------
# Fills the gap left by Finnhub's free tier 403ing on /stock/eps-estimate and
# /stock/price-target. Free tier is 25 requests/day — scripts/ingest_consensus_estimates.py's
# default --limit keeps each scheduled run within that cap.
# Get a free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# -----------------------------------------------------------------------------
# FHLB Office of Finance (Free, keyless — agency/GSE bond reference data)
# -----------------------------------------------------------------------------
# Debt-statistics workbook URL for the Federal Home Loan Banks' Office of
# Finance, used by scripts/ingest_agency_bonds.py. No signup/API key.
# Verified live 2026-07-22 (real XLSX file, ~230 CUSIPs on the "Outstanding
# TAP Issues" sheet — a real but partial slice of FHLB's outstanding debt,
# not the full ~$850B+ universe). If fhlb-of.com changes this URL again,
# browse https://www.fhlb-of.com/debt-securities/debt-statistics/ for the
# current "Issuance and Outstanding Summaries" download link.
FHLB_OF_DATA_URL=https://cdn.fhlb-of.com/files/Debt%20Statistics/debtstatistics.xlsx

# -----------------------------------------------------------------------------
# AI Services (Optional — powers AI narratives, semantic search, Q&A)
# -----------------------------------------------------------------------------
# Anthropic Claude — AI market narratives, company primers, analyst Q&A
# Get an API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google AI — text embeddings for semantic search
# Get an API key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# Object Storage (Optional — S3/MinIO for raw file storage)
# -----------------------------------------------------------------------------
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=bloomberg-raw

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_V1_PREFIX=/v1
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000

# -----------------------------------------------------------------------------
# Analytics Engine (Pillar 2)
# -----------------------------------------------------------------------------
ANALYTICS_DEFAULT_ERP=0.055
ANALYTICS_BETA_LOOKBACK_DAYS=756
ANALYTICS_BETA_BLUME_WEIGHT=0.67
ANALYTICS_RISK_FREE_INDICATOR=DGS10
ANALYTICS_MARKET_BENCHMARK_TICKER=SPY

# -----------------------------------------------------------------------------
# Cache TTLs (seconds)
# -----------------------------------------------------------------------------
CACHE_TTL_REFERENCE=3600
CACHE_TTL_ENTITY=900
CACHE_TTL_SECURITY=900
CACHE_TTL_MACRO=1800
CACHE_TTL_FUNDAMENTALS=3600
CACHE_TTL_OWNERSHIP=3600
CACHE_TTL_ESG=7200
CACHE_TTL_ANALYTICS_RATIOS=86400
CACHE_TTL_ANALYTICS_MULTIPLES=14400
CACHE_TTL_ANALYTICS_WACC=86400
CACHE_TTL_ANALYTICS_DUPONT=86400

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Set this in frontend/.env (not here) — the Vite dev server reads it
# VITE_API_URL=http://localhost:8000
